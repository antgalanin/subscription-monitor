# Прод-конфигурация: TLS-сертификат Cloudflare Origin CA,
# входящие соединения только от Cloudflare (Authenticated Origin Pulls)
https://{$DOMAIN} {
	tls /certs/origin.pem /certs/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /certs/authenticated_origin_pull_ca.pem
		}
	}

	encode gzip

	handle /api/* {
		import /etc/caddy/upstream.caddy
	}

	handle {
		root * /srv

		# Хешированные бандлы не меняются, остальное перепроверяется на каждый запрос
		@immutable path /assets/*
		@revalidate not path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @revalidate Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
